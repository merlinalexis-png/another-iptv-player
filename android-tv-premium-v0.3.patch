+@Composable
+private fun TvSourceCard(movie: VodStreamEntity, selected: Boolean, onClick: () -> Unit) {
+    var focused by remember { mutableStateOf(false) }
+    Column(
+        modifier = Modifier.width(245.dp).onFocusChanged { focused = it.isFocused }
+            .clip(RoundedCornerShape(14.dp))
+            .background(if (focused) Color.White else if (selected) TvAccent.copy(alpha = 0.24f) else TvSurfaceRaised)
+            .clickable(onClick = onClick).focusable().padding(15.dp),
+    ) {
+        Text(sourceTags(movie.name).ifEmpty { listOf(movie.containerExtension?.uppercase() ?: "AUTO") }.joinToString(" • "), color = if (focused) TvCanvas else TvAccentMint, fontSize = 12.sp, fontWeight = FontWeight.Bold)
+        Text(movie.name, color = if (focused) TvCanvas else TvTextPrimary, fontSize = 12.sp, maxLines = 2, overflow = TextOverflow.Ellipsis, modifier = Modifier.padding(top = 6.dp))
+        Text(inferredTracks(movie.name), color = if (focused) TvCanvas.copy(alpha = 0.62f) else TvTextSecondary, fontSize = 9.sp, modifier = Modifier.padding(top = 5.dp))
+    }
+}
