+@Composable
+private fun TvMetaBadge(text: String, accent: Color = Color.White.copy(alpha = 0.11f)) {
+    Text(text, color = TvTextPrimary, fontSize = 11.sp, fontWeight = FontWeight.SemiBold, modifier = Modifier.clip(RoundedCornerShape(6.dp)).background(accent.copy(alpha = if (accent == TvAccent || accent == TvAccentMint) 0.35f else 1f)).padding(horizontal = 8.dp, vertical = 4.dp))
+}
+
+@Composable
+private fun TvRoundIcon(icon: androidx.compose.ui.graphics.vector.ImageVector, description: String, onClick: () -> Unit, modifier: Modifier = Modifier) {
+    var focused by remember { mutableStateOf(false) }
+    Box(
+        modifier = modifier.size(42.dp).onFocusChanged { focused = it.isFocused }.clip(RoundedCornerShape(21.dp))
+            .background(if (focused) Color.White else TvCanvas.copy(alpha = 0.7f)).clickable(onClick = onClick).focusable(),
+        contentAlignment = Alignment.Center,
+    ) { Icon(icon, description, tint = if (focused) TvCanvas else Color.White) }
+}
+
+private fun cleanDisplayTitle(value: String): String = value
+    .replace(Regex("(?i)[\\[({].*?(4k|uhd|fhd|hd|multi|vff|vfq|vostfr|truefrench|fr).*?[\\])}]") , " ")
+    .replace(Regex("\\s+"), " ").trim()
+
+private fun sourceTags(value: String): List<String> {
+    val upper = value.uppercase()
+    return listOf("4K", "UHD", "FHD", "HD", "MULTI", "VFF", "VFQ", "VOSTFR", "TRUEFRENCH")
+        .filter { Regex("(^|[^A-Z0-9])${Regex.escape(it)}([^A-Z0-9]|$)").containsMatchIn(upper) }
+        .distinct()
+}
+
+private fun inferredTracks(value: String): String {
+    val tags = sourceTags(value)
+    val audio = when {
+        "MULTI" in tags -> "Audio : plusieurs langues"
+        "VFF" in tags || "TRUEFRENCH" in tags -> "Audio : français (France)"
+        "VFQ" in tags -> "Audio : français (Québec)"
+        "VOSTFR" in tags -> "Audio : original • sous-titres FR annoncés"
+        else -> "Audio et sous-titres détectés à la lecture"
+    }
+    return audio
+}
