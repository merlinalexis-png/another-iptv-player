+@Composable
+private fun TvMovieHero(
+    movie: VodStreamEntity,
+    loadingMetadata: Boolean,
+    onBack: () -> Unit,
+    onPlay: (Int) -> Unit,
+) {
+    Box(Modifier.fillMaxWidth().height(470.dp)) {
+        val backdrop = movie.backdropPath ?: movie.streamIcon
+        if (!backdrop.isNullOrBlank()) {
+            AsyncImage(backdrop, contentDescription = null, contentScale = ContentScale.Crop, modifier = Modifier.fillMaxSize())
+        }
+        Box(
+            Modifier.fillMaxSize().background(
+                Brush.horizontalGradient(
+                    0f to TvCanvas,
+                    0.5f to TvCanvas.copy(alpha = 0.82f),
+                    1f to TvCanvas.copy(alpha = 0.18f),
+                ),
+            ).background(
+                Brush.verticalGradient(0f to TvCanvas.copy(alpha = 0.2f), 0.75f to Color.Transparent, 1f to TvCanvas),
+            ),
+        )
+        TvRoundIcon(Icons.AutoMirrored.Filled.ArrowBack, stringResource(R.string.common_back), onBack, Modifier.padding(34.dp))
+        Column(
+            modifier = Modifier.align(Alignment.CenterStart).padding(start = 52.dp, top = 68.dp).fillMaxWidth(0.57f),
+            verticalArrangement = Arrangement.spacedBy(13.dp),
+        ) {
+            Text(cleanDisplayTitle(movie.name), color = TvTextPrimary, fontSize = 35.sp, lineHeight = 39.sp, fontWeight = FontWeight.Bold, maxLines = 2, overflow = TextOverflow.Ellipsis)
+            Row(horizontalArrangement = Arrangement.spacedBy(9.dp), verticalAlignment = Alignment.CenterVertically) {
+                movie.rating?.takeIf { it.isNotBlank() }?.let { TvMetaBadge("★ $it", TvAccentMint) }
+                movie.releaseDate?.take(4)?.let { TvMetaBadge(it) }
+                movie.duration?.takeIf { it.isNotBlank() }?.let { TvMetaBadge(it) }
+                movie.containerExtension?.uppercase()?.let { TvMetaBadge(it) }
+            }
+            val tags = sourceTags(movie.name)
+            if (tags.isNotEmpty()) {
+                Row(horizontalArrangement = Arrangement.spacedBy(7.dp)) { tags.forEach { TvMetaBadge(it, TvAccent) } }
+            }
+            Text(
+                text = movie.plot?.takeIf { it.isNotBlank() }
+                    ?: if (loadingMetadata) stringResource(R.string.detail_metadata_loading) else stringResource(R.string.detail_no_synopsis),
+                color = TvTextPrimary.copy(alpha = 0.82f),
+                fontSize = 14.sp,
+                lineHeight = 20.sp,
+                maxLines = 5,
+                overflow = TextOverflow.Ellipsis,
+            )
+            movie.cast?.takeIf { it.isNotBlank() }?.let {
+                Text(stringResource(R.string.detail_cast_format, it), color = TvTextSecondary, fontSize = 12.sp, maxLines = 2, overflow = TextOverflow.Ellipsis)
+            }
+            movie.director?.takeIf { it.isNotBlank() }?.let {
+                Text(stringResource(R.string.detail_director_format, it), color = TvTextSecondary, fontSize = 12.sp, maxLines = 1, overflow = TextOverflow.Ellipsis)
+            }
+            Text(
+                text = inferredTracks(movie.name),
+                color = TvTextSecondary.copy(alpha = 0.82f),
+                fontSize = 11.sp,
+            )
+            TvActionButton(
+                text = stringResource(R.string.detail_watch),
+                icon = Icons.Default.PlayArrow,
+                primary = true,
+                onClick = { onPlay(movie.streamId) },
+            )
+        }
+    }
+}
