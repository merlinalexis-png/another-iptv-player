     suspend fun find(streamId: Int, playlistId: String): VodStreamEntity? =
         dao.findById(streamId, playlistId)
 
+    suspend fun variants(playlistId: String, title: String, excludeStreamId: Int): List<VodStreamWithCategory> {
+        val stem = title
+            .replace(Regex("(?i)\\b(4k|uhd|fhd|hd|sd|multi|vff|vfq|vostfr|truefrench|fr|en)\\b"), " ")
+            .replace(Regex("[\\[\\](){}._-]+"), " ")
+            .replace(Regex("\\s+"), " ")
+            .trim()
+            .take(42)
+        if (stem.length < 3) return emptyList()
+        return dao.search(playlistId, stem, 18)
+            .filter { it.stream.streamId != excludeStreamId && normalizedTitle(it.stream.name) == normalizedTitle(title) }
+    }
+
+    suspend fun similar(playlistId: String, movie: VodStreamEntity): List<VodStreamWithCategory> {
+        val categoryId = movie.categoryId ?: return emptyList()
+        return dao.similarByCategory(playlistId, categoryId, movie.streamId, 18)
+            .filterNot { normalizedTitle(it.stream.name) == normalizedTitle(movie.name) }
+            .take(12)
+    }
+
+    private fun normalizedTitle(value: String): String = value.lowercase()
+        .replace(Regex("(?i)\\b(4k|uhd|fhd|hd|sd|multi|vff|vfq|vostfr|truefrench|fr|en)\\b"), " ")
+        .replace(Regex("\\b(19|20)\\d{2}\\b"), " ")
+        .replace(Regex("[^a-z0-9à-ÿ]+"), " ")
+        .trim()
+
     /**
      * Merges a `get_vod_info` response onto the persisted row. Mirrors iOS
      * `MovieDetailView.fetchMovieInfo`: every nullable field on the
