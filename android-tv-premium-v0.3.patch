+private fun applyAppLanguage(context: android.content.Context, languageTag: String) {
+    context.getSharedPreferences("appearance", android.content.Context.MODE_PRIVATE)
+        .edit().putString("language", languageTag).apply()
+    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+        context.getSystemService(LocaleManager::class.java)
+            .applicationLocales = LocaleList.forLanguageTags(languageTag)
+    } else {
+        @Suppress("DEPRECATION")
+        val configuration = context.resources.configuration
+        configuration.setLocale(java.util.Locale.forLanguageTag(languageTag))
+        @Suppress("DEPRECATION")
+        context.resources.updateConfiguration(configuration, context.resources.displayMetrics)
+        (context as? ComponentActivity)?.recreate()
+    }
+}
