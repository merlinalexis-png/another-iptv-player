@@ -109,6 +109,27 @@ interface VodStreamDao {
     )
     suspend fun search(playlistId: String, query: String, limit: Int): List<VodStreamWithCategory>
 
+    @Query(
+        """
+        SELECT vodStream.*, COALESCE(category.name, '') AS categoryName
+        FROM vodStream
+        LEFT JOIN category ON vodStream.categoryId = category.id
+                          AND vodStream.playlistId = category.playlistId
+                          AND category.type = 'vod'
+        WHERE vodStream.playlistId = :playlistId
+          AND vodStream.categoryId = :categoryId
+          AND vodStream.streamId != :excludeStreamId
+        ORDER BY CAST(COALESCE(vodStream.rating, '0') AS REAL) DESC, vodStream.sortIndex
+        LIMIT :limit
+        """
+    )
+    suspend fun similarByCategory(
+        playlistId: String,
+        categoryId: String,
+        excludeStreamId: Int,
+        limit: Int,
+    ): List<VodStreamWithCategory>
+
     /** Single-row update — Room generates UPDATE by composite PK. */
     @Update
     suspend fun update(row: VodStreamEntity)
