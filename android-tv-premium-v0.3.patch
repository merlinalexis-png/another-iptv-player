+@Composable
+fun TvMovieDetailScreen(
+    playlistId: String,
+    streamId: Int,
+    onBack: () -> Unit,
+    onPlay: (Int) -> Unit,
+    onOpenMovie: (Int) -> Unit,
+) {
+    val playlists = LocalPlaylistRepository.current
+    val repository = LocalVodRepository.current
+    val movie by repository.observe(streamId, playlistId).collectAsStateWithLifecycle(initialValue = null)
+    var variants by remember(streamId) { mutableStateOf<List<VodStreamWithCategory>>(emptyList()) }
+    var similar by remember(streamId) { mutableStateOf<List<VodStreamWithCategory>>(emptyList()) }
+    var loadingMetadata by remember(streamId) { mutableStateOf(false) }
+
+    BackHandler(onBack = onBack)
+    LaunchedEffect(streamId, movie?.metadataLoaded) {
+        val current = movie ?: return@LaunchedEffect
+        val playlist = playlists.find(playlistId) ?: return@LaunchedEffect
+        if (!current.metadataLoaded && !loadingMetadata) {
+            loadingMetadata = true
+            runCatching { XtreamApiClient(playlist).getVODInfo(streamId).info ?: XtreamVODInfo() }
+                .onSuccess { repository.applyInfo(streamId, playlistId, it) }
+                .onFailure { Log.w("TvMovieDetail", "Metadata failed (${it.javaClass.simpleName})") }
+            loadingMetadata = false
+        }
+        variants = repository.variants(playlistId, current.name, streamId)
+        similar = repository.similar(playlistId, current)
+    }
+
+    val current = movie
+    if (current == null) {
+        Box(Modifier.fillMaxSize().background(TvCanvas), contentAlignment = Alignment.Center) {
+            CircularProgressIndicator(color = TvAccentMint)
+        }
+        return
+    }
+
+    LazyColumn(
+        modifier = Modifier.fillMaxSize().background(TvCanvas),
+        contentPadding = PaddingValues(bottom = 54.dp),
+        verticalArrangement = Arrangement.spacedBy(24.dp),
+    ) {
+        item(key = "hero") {
+            TvMovieHero(current, loadingMetadata, onBack, onPlay)
+        }
+        if (variants.isNotEmpty()) {
+            item(key = "sources") {
+                TvSourcesRail(current, variants, onPlay)
+            }
+        }
+        if (similar.isNotEmpty()) {
+            item(key = "similar") {
+                TvShelf(title = stringResource(R.string.detail_similar)) {
+                    LazyRow(
+                        contentPadding = PaddingValues(horizontal = 48.dp, vertical = 8.dp),
+                        horizontalArrangement = Arrangement.spacedBy(14.dp),
+                    ) {
+                        items(similar, key = { it.id }) { row ->
+                            TvPosterCard(
+                                title = row.stream.name,
+                                imageUrl = row.stream.streamIcon,
+                                eyebrow = row.stream.rating?.let { "★ $it" },
+                                width = 126.dp,
+                                onClick = { onOpenMovie(row.stream.streamId) },
+                            )
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
