+package dev.android.anotheriptvplayer.ui.tv
+
+import android.content.Context
+import androidx.compose.foundation.background
+import androidx.compose.foundation.clickable
+import androidx.compose.foundation.focusable
+import androidx.compose.foundation.layout.*
+import androidx.compose.foundation.shape.CircleShape
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.material.icons.Icons
+import androidx.compose.material.icons.filled.Add
+import androidx.compose.material.icons.filled.Person
+import androidx.compose.material3.*
+import androidx.compose.runtime.*
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.clip
+import androidx.compose.ui.focus.onFocusChanged
+import androidx.compose.ui.graphics.Brush
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.text.font.FontWeight
+import androidx.compose.ui.text.style.TextOverflow
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.sp
+import dev.android.anotheriptvplayer.R
+
+internal class TvProfileStore(context: Context) {
+    private val prefs = context.getSharedPreferences("tv_profiles", Context.MODE_PRIVATE)
+
+    fun names(): List<String> = prefs.getStringSet("names", null)
+        ?.toList()?.sorted()?.takeIf { it.isNotEmpty() }
+        ?: listOf("Profil principal")
+
+    fun add(name: String): List<String> {
+        val updated = (names() + name.trim()).filter { it.isNotBlank() }.distinct().take(5)
+        prefs.edit().putStringSet("names", updated.toSet()).apply()
+        return updated
+    }
+
+    fun select(name: String) { prefs.edit().putString("active", name).apply() }
+}
+
+@Composable
+internal fun TvProfilePicker(onSelected: (String) -> Unit) {
+    val context = LocalContext.current
+    val store = remember(context) { TvProfileStore(context) }
+    var profiles by remember { mutableStateOf(store.names()) }
+    var showAdd by remember { mutableStateOf(false) }
+    var newName by remember { mutableStateOf("") }
+
+    Box(
+        modifier = Modifier.fillMaxSize().background(
+            Brush.radialGradient(
+                colors = listOf(Color(0x553C2D7A), TvCanvas, Color(0xFF051315)),
+                radius = 1200f,
+            ),
+        ),
+    ) {
+        Column(
+            modifier = Modifier.align(Alignment.Center),
+            horizontalAlignment = Alignment.CenterHorizontally,
+        ) {
+            Text(stringResource(R.string.tv_profiles_title), color = TvTextPrimary, fontSize = 34.sp, fontWeight = FontWeight.Bold)
+            Text(
+                stringResource(R.string.tv_profiles_subtitle),
+                color = TvTextSecondary,
+                fontSize = 15.sp,
+                modifier = Modifier.padding(top = 8.dp),
+            )
+            Spacer(Modifier.height(34.dp))
+            Row(horizontalArrangement = Arrangement.spacedBy(26.dp)) {
+                profiles.forEachIndexed { index, profile ->
+                    TvProfileCard(
+                        name = profile,
+                        accent = if (index % 2 == 0) TvAccent else TvAccentMint,
+                        onClick = { store.select(profile); onSelected(profile) },
+                    )
+                }
+                if (profiles.size < 5) {
+                    TvProfileCard(
+                        name = stringResource(R.string.tv_profile_add),
+                        accent = Color(0xFF495064),
+                        isAdd = true,
+                        onClick = { showAdd = true },
+                    )
+                }
+            }
+            Text(
+                stringResource(R.string.tv_phone_keyboard_hint),
+                color = TvTextSecondary.copy(alpha = 0.72f),
+                fontSize = 12.sp,
+                modifier = Modifier.padding(top = 34.dp),
+            )
+        }
+    }
+
+    if (showAdd) {
+        AlertDialog(
+            onDismissRequest = { showAdd = false },
+            title = { Text(stringResource(R.string.tv_profile_add_title)) },
+            text = {
+                OutlinedTextField(
+                    value = newName,
+                    onValueChange = { newName = it.take(24) },
+                    label = { Text(stringResource(R.string.tv_profile_name)) },
+                    singleLine = true,
+                )
+            },
+            confirmButton = {
+                TextButton(
+                    enabled = newName.isNotBlank(),
+                    onClick = { profiles = store.add(newName); newName = ""; showAdd = false },
+                ) { Text(stringResource(R.string.common_add)) }
+            },
+            dismissButton = {
+                TextButton(onClick = { showAdd = false }) { Text(stringResource(R.string.common_cancel)) }
+            },
+        )
+    }
+}
+
+@Composable
+private fun TvProfileCard(name: String, accent: Color, isAdd: Boolean = false, onClick: () -> Unit) {
+    var focused by remember { mutableStateOf(false) }
+    Column(
+        modifier = Modifier.width(142.dp).onFocusChanged { focused = it.isFocused }
+            .clip(RoundedCornerShape(20.dp))
+            .background(if (focused) Color.White.copy(alpha = 0.12f) else Color.Transparent)
+            .clickable(onClick = onClick).focusable().padding(14.dp),
+        horizontalAlignment = Alignment.CenterHorizontally,
+    ) {
+        Box(
+            modifier = Modifier.size(104.dp).clip(CircleShape).background(
+                Brush.linearGradient(
+                    if (isAdd) listOf(Color.White.copy(alpha = 0.08f), Color.White.copy(alpha = 0.08f))
+                    else listOf(accent, accent.copy(alpha = 0.35f)),
+                ),
+            ),
+            contentAlignment = Alignment.Center,
+        ) {
+            Icon(
+                if (isAdd) Icons.Default.Add else Icons.Default.Person,
+                contentDescription = null,
+                tint = Color.White,
+                modifier = Modifier.size(if (isAdd) 38.dp else 52.dp),
+            )
+        }
+        Text(
+            name,
+            color = if (focused) Color.White else TvTextSecondary,
+            fontSize = 14.sp,
+            fontWeight = FontWeight.SemiBold,
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis,
+            modifier = Modifier.padding(top = 12.dp),
+        )
+    }
+}
