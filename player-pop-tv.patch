+@Composable
+internal fun ContinueWatchingRail(
+    rows: List<WatchHistoryEntity>,
+    onOpen: (WatchHistoryEntity) -> Unit,
+) {
+    if (rows.isEmpty()) return
+    TvShelf(title = stringResource(R.string.shelf_continue_watching)) {
+        LazyRow(
+            contentPadding = PaddingValues(horizontal = 48.dp, vertical = 10.dp),
+            horizontalArrangement = Arrangement.spacedBy(18.dp),
+        ) {
+            items(rows, key = { it.id }) { row ->
+                val progress = if (row.type != "live" && row.durationMs > 0L) {
+                    row.lastTimeMs.toFloat() / row.durationMs.toFloat()
+                } else null
+                TvLandscapeCard(
+                    title = row.secondaryTitle ?: row.title,
+                    subtitle = if (row.secondaryTitle != null) row.title else null,
+                    imageUrl = row.imageUrl,
+                    progress = progress,
+                    icon = when (row.type) {
+                        "live" -> Icons.Default.LiveTv
+                        "series" -> Icons.Default.Tv
+                        else -> Icons.Default.Movie
+                    },
+                    onClick = { onOpen(row) },
+                )
+            }
+        }
+    }
+}
