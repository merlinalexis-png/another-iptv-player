+import dev.android.anotheriptvplayer.ui.LocalHiddenCategoryStore
+import dev.android.anotheriptvplayer.ui.LocalPlaylistContentStore
+import dev.android.anotheriptvplayer.ui.LocalPlaylistRepository
+import dev.android.anotheriptvplayer.ui.settings.PlaylistSettingsBody
+import kotlinx.coroutines.launch
+
+/**
+ * Android TV home built around a ten-foot/D-pad interaction model.
+ *
+ * The networking, Room database and player remain shared with the mobile
+ * client. Only the presentation and navigation shell are TV-specific, which
+ * lets the fork keep receiving parser/player fixes without coupling the TV UI
+ * to the phone layout.
+ */
+@Composable
+fun PremiumTvDashboardScreen(
+    playlistId: String,
+    onBack: () -> Unit,
+    onOpenMovie: (Int) -> Unit,
+    onPlayMovie: (Int) -> Unit,
+    onOpenSeries: (Int) -> Unit,
+    onOpenLiveCategory: (String) -> Unit,
+    onOpenVodCategory: (String) -> Unit,
+    onOpenSeriesCategory: (String) -> Unit,
+    onPlayLive: (Int) -> Unit,
+    onOpenDownloads: () -> Unit,
+    onOpenHistory: () -> Unit,
+    onOpenSearch: () -> Unit,
+    onResumeEpisode: (String) -> Unit,
+    appVersion: String,
+) {
+    val context = androidx.compose.ui.platform.LocalContext.current
+    val app = context.applicationContext as AnotherIptvPlayerApp
+    val repository = LocalPlaylistRepository.current
+    val contentStore = LocalPlaylistContentStore.current
+    val hiddenStore = LocalHiddenCategoryStore.current
+    val scope = rememberCoroutineScope()
+
+    var playlist by remember(playlistId) { mutableStateOf<Playlist?>(null) }
+    var destination by remember { mutableStateOf(TvDestination.Home) }
+    var settingsVisible by remember { mutableStateOf(false) }
+    var notificationPanelVisible by remember { mutableStateOf(false) }
+    var isAutoRefreshing by remember { mutableStateOf(false) }
+
+    val refreshPolicy = remember(context) { CatalogRefreshPolicy(context) }
+    val updateReadStore = remember(context) { EpisodeUpdateReadStore(context) }
+    var readSignatures by remember(playlistId) {
+        mutableStateOf(updateReadStore.readSignatures(playlistId))
+    }
+
+    val isLoading by contentStore.isLoading.collectAsStateWithLifecycle()
+    val loadingMessage by contentStore.loadingMessage.collectAsStateWithLifecycle()
+    val loadError by contentStore.loadError.collectAsStateWithLifecycle()
+    val liveCategories by contentStore.liveCategories.collectAsStateWithLifecycle()
+    val movieCategories by contentStore.vodCategories.collectAsStateWithLifecycle()
+    val seriesCategories by contentStore.seriesCategories.collectAsStateWithLifecycle()
+    val liveByCategory by contentStore.liveStreamsByCategoryId.collectAsStateWithLifecycle()
+    val moviesByCategory by contentStore.vodStreamsByCategoryId.collectAsStateWithLifecycle()
+    val seriesByCategory by contentStore.seriesItemsByCategoryId.collectAsStateWithLifecycle()
+    val movies by contentStore.vodStreams.collectAsStateWithLifecycle()
+    val series by contentStore.seriesItems.collectAsStateWithLifecycle()
+    val history by app.appDatabaseForDownloads
+        .watchHistoryDao()
+        .observeRecent(playlistId, limit = 80)
+        .collectAsStateWithLifecycle(initialValue = emptyList())
+
+    val hiddenLive by hiddenStore.observeHidden(playlistId, "live")
+        .collectAsStateWithLifecycle(initialValue = hiddenStore.hiddenIds(playlistId, "live"))
+    val hiddenMovies by hiddenStore.observeHidden(playlistId, "vod")
+        .collectAsStateWithLifecycle(initialValue = hiddenStore.hiddenIds(playlistId, "vod"))
+    val hiddenSeries by hiddenStore.observeHidden(playlistId, "series")
+        .collectAsStateWithLifecycle(initialValue = hiddenStore.hiddenIds(playlistId, "series"))
+
+    val visibleLiveCategories = remember(liveCategories, hiddenLive) {
+        liveCategories.filter { it.id !in hiddenLive }
+    }
+    val visibleMovieCategories = remember(movieCategories, hiddenMovies) {
+        movieCategories.filter { it.id !in hiddenMovies }
+    }
+    val visibleSeriesCategories = remember(seriesCategories, hiddenSeries) {
+        seriesCategories.filter { it.id !in hiddenSeries }
+    }
+
+    val updates = remember(series, history, readSignatures) {
+        EpisodeUpdateDetector.detect(series, history, readSignatures)
+    }
+    val unreadCount = remember(updates) { updates.count { it.isUnread } }
+
+    LaunchedEffect(playlistId) {
+        val resolved = repository.find(playlistId)
+        playlist = resolved
+        if (resolved == null) return@LaunchedEffect
+
+        val hadRefreshBaseline = refreshPolicy.hasBaseline(playlistId)
+        contentStore.loadPlaylistSuspending(resolved)
+
+        // The bootstrap already fetched the full catalog. Establish a
+        // baseline rather than downloading it twice on first TV launch.
+        if (!hadRefreshBaseline) {
+            refreshPolicy.markRefreshed(playlistId)
+        } else if (refreshPolicy.shouldRefresh(playlistId)) {
+            isAutoRefreshing = true
+            runCatching {
+                contentStore.syncFromNetworkReplacingLocal(resolved) { }
+                contentStore.reloadFromDatabase(playlistId)
+                refreshPolicy.markRefreshed(playlistId)
+            }
+            isAutoRefreshing = false
+        }
+    }
+
+    BackHandler(
+        enabled = !notificationPanelVisible &&
+            (settingsVisible || destination != TvDestination.Home),
+    ) {
+        when {
+            settingsVisible -> settingsVisible = false
+            destination != TvDestination.Home -> destination = TvDestination.Home
+            else -> onBack()
+        }
+    }
+
+    Box(
+        modifier = Modifier
+            .fillMaxSize()
+            .background(
+                Brush.verticalGradient(
+                    listOf(TvCanvas, androidx.compose.ui.graphics.Color(0xFF090B11), TvCanvas),
+                ),
+            ),
+    ) {
+        when {
+            loadError != null && movies.isEmpty() && series.isEmpty() && liveByCategory.isEmpty() -> {
+                TvLoadError(
+                    message = loadError ?: stringResource(R.string.error_generic),
+                    onRetry = {
+                        playlist?.let { current ->
+                            scope.launch { contentStore.loadPlaylistSuspending(current) }
+                        }
+                    },
+                )
+            }
+
+            isLoading && movies.isEmpty() && series.isEmpty() && liveByCategory.isEmpty() -> {
+                TvLoadingState(message = loadingMessage)
+            }
+
+            settingsVisible -> {
+                PlaylistSettingsBody(
+                    playlistId = playlistId,
+                    appVersion = appVersion,
+                    onOpenDownloads = onOpenDownloads,
+                    onOpenHistory = onOpenHistory,
+                    modifier = Modifier.fillMaxSize().padding(top = 88.dp, start = 36.dp, end = 36.dp),
+                )
+            }
+
+            destination == TvDestination.Home -> {
+                TvHomeScreen(
+                    movies = movies,
+                    series = series,
+                    history = history,
+                    onOpenMovie = onOpenMovie,
+                    onPlayMovie = onPlayMovie,
+                    onOpenSeries = onOpenSeries,
+                    onResumeHistory = { row ->
+                        when (row.type) {
+                            "vod" -> row.streamId.toIntOrNull()?.let(onPlayMovie)
+                            "series" -> onResumeEpisode(row.streamId)
+                            "live" -> row.streamId.toIntOrNull()?.let(onPlayLive)
+                        }
+                    },
+                    onShowMovies = {
+                        settingsVisible = false
+                        destination = TvDestination.Movies
+                    },
+                    onShowSeries = {
+                        settingsVisible = false
+                        destination = TvDestination.Series
+                    },
+                )
+            }
+
+            else -> {
+                val categories = when (destination) {
+                    TvDestination.Live -> visibleLiveCategories
+                    TvDestination.Movies -> visibleMovieCategories
+                    TvDestination.Series -> visibleSeriesCategories
+                    TvDestination.Home -> emptyList()
+                }
+                TvCatalogScreen(
+                    destination = destination,
+                    categories = categories,
+                    liveByCategory = liveByCategory,
+                    moviesByCategory = moviesByCategory,
+                    seriesByCategory = seriesByCategory,
+                    onOpenLiveCategory = onOpenLiveCategory,
+                    onOpenMovieCategory = onOpenVodCategory,
+                    onOpenSeriesCategory = onOpenSeriesCategory,
+                    onPlayLive = onPlayLive,
+                    onOpenMovie = onOpenMovie,
+                    onOpenSeries = onOpenSeries,
+                )
+            }
+        }
+
+        TvTopNavigation(
+            destination = destination,
+            unreadCount = unreadCount,
+            isRefreshing = isAutoRefreshing,
+            onDestination = {
+                settingsVisible = false
+                destination = it
+            },
+            onSearch = onOpenSearch,
+            onNotifications = { notificationPanelVisible = true },
+            onSettings = { settingsVisible = true },
+            modifier = Modifier.align(Alignment.TopCenter),
+        )
+
+        EpisodeUpdatesOverlay(
+            visible = notificationPanelVisible,
+            updates = updates,
+            unreadCount = unreadCount,
+            onDismiss = { notificationPanelVisible = false },
+            onMarkAllRead = {
+                readSignatures = updateReadStore.markRead(
+                    playlistId,
+                    updates.map { it.signature },
+                )
+            },
+            onOpenSeries = { update ->
+                readSignatures = updateReadStore.markRead(playlistId, listOf(update.signature))
+                notificationPanelVisible = false
+                onOpenSeries(update.seriesId)
+            },
+        )
+    }
+}
+
+@Composable
+private fun TvLoadingState(message: String?) {
+    Column(
+        modifier = Modifier.fillMaxSize(),
+        horizontalAlignment = Alignment.CenterHorizontally,
+        verticalArrangement = Arrangement.Center,
+    ) {
+        CircularProgressIndicator(color = TvAccentMint)
+        Text(
+            text = message ?: stringResource(R.string.common_loading),
+            color = TvTextSecondary,
+            fontSize = 14.sp,
+            modifier = Modifier.padding(top = 16.dp),
+        )
+    }
+}
+
+@Composable
+private fun TvLoadError(message: String, onRetry: () -> Unit) {
+    Column(
+        modifier = Modifier.fillMaxSize().padding(48.dp),
+        horizontalAlignment = Alignment.CenterHorizontally,
+        verticalArrangement = Arrangement.Center,
+    ) {
+        Icon(
+            imageVector = Icons.Default.ErrorOutline,
+            contentDescription = null,
+            tint = androidx.compose.ui.graphics.Color(0xFFFF7A85),
+        )
+        Spacer(Modifier.height(12.dp))
+        Text(text = message, color = TvTextPrimary, fontSize = 15.sp)
+        Spacer(Modifier.height(18.dp))
+        TvActionButton(
+            text = stringResource(R.string.common_retry),
+            onClick = onRetry,
+            primary = true,
+        )
+    }
+}
