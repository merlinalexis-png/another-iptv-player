+@Composable
+internal fun TvHomeScreen(
+    movies: List<VodStreamWithCategory>,
+    series: List<SeriesWithCategory>,
+    history: List<WatchHistoryEntity>,
+    onOpenMovie: (Int) -> Unit,
+    onPlayMovie: (Int) -> Unit,
+    onOpenSeries: (Int) -> Unit,
+    onResumeHistory: (WatchHistoryEntity) -> Unit,
+    onShowMovies: () -> Unit,
+    onShowSeries: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val hero = remember(movies) { selectHero(movies) }
+    val recentlyAdded = remember(movies) {
+        movies.sortedByDescending { it.stream.added?.toLongOrNull() ?: Long.MIN_VALUE }.take(24)
+    }
+    val topRated = remember(movies) {
+        movies
+            .filter { (it.stream.rating?.toDoubleOrNull() ?: 0.0) > 0.0 }
+            .sortedByDescending { it.stream.rating?.toDoubleOrNull() ?: 0.0 }
+            .take(24)
+    }
+    val updatedSeries = remember(series) {
+        series.sortedByDescending {
+            dev.android.anotheriptvplayer.data.EpisodeUpdateDetector
+                .parseProviderTimestamp(it.series.lastModified) ?: Long.MIN_VALUE
+        }.take(24)
+    }
+    val continueRows = remember(history) {
+        history.distinctBy { row ->
+            if (row.type == "series") "series:${row.seriesId ?: row.streamId}" else row.id
+        }.take(18)
+    }
+    val personalizedMovies = remember(movies, series, history) {
+        selectPersonalizedMovies(movies, series, history)
+    }
+
+    LazyColumn(
+        modifier = modifier.fillMaxSize(),
+        contentPadding = PaddingValues(bottom = 64.dp),
+        verticalArrangement = Arrangement.spacedBy(18.dp),
+    ) {
+        item(key = "hero") {
+            if (hero != null) {
+                TvHero(
+                    movie = hero,
+                    onPlay = { onPlayMovie(hero.stream.streamId) },
+                    onDetails = { onOpenMovie(hero.stream.streamId) },
+                )
+            } else {
+                TvHeroPlaceholder()
+            }
+        }
+
+        if (continueRows.isNotEmpty()) {
+            item(key = "continue") {
+                ContinueWatchingRail(rows = continueRows, onOpen = onResumeHistory)
+            }
+        }
+
+        if (personalizedMovies.isNotEmpty()) {
+            item(key = "personalized") {
+                MovieRail(
+                    title = stringResource(R.string.tv_shelf_for_you),
+                    subtitle = stringResource(R.string.tv_shelf_for_you_subtitle),
+                    movies = personalizedMovies,
+                    onOpenMovie = onOpenMovie,
+                    onSeeAll = onShowMovies,
+                )
+            }
+        }
+
+        if (recentlyAdded.isNotEmpty()) {
+            item(key = "recent") {
+                MovieRail(
+                    title = stringResource(R.string.shelf_recently_added),
+                    movies = recentlyAdded,
+                    onOpenMovie = onOpenMovie,
+                    onSeeAll = onShowMovies,
+                )
+            }
+        }
+
+        if (updatedSeries.isNotEmpty()) {
+            item(key = "series") {
+                SeriesRail(
+                    title = stringResource(R.string.tv_shelf_series),
+                    series = updatedSeries,
+                    onOpenSeries = onOpenSeries,
+                    onSeeAll = onShowSeries,
+                )
+            }
+        }
+
+        if (topRated.isNotEmpty()) {
+            item(key = "top-rated") {
+                MovieRail(
+                    title = stringResource(R.string.tv_shelf_top_rated),
+                    subtitle = stringResource(R.string.tv_shelf_top_rated_subtitle),
+                    movies = topRated,
+                    onOpenMovie = onOpenMovie,
+                    onSeeAll = onShowMovies,
+                )
+            }
+        }
+    }
+}
