diff --git a/apps/android/app/src/test/java/dev/android/anotheriptvplayer/data/EpisodeUpdateDetectorTest.kt b/apps/android/app/src/test/java/dev/android/anotheriptvplayer/data/EpisodeUpdateDetectorTest.kt
