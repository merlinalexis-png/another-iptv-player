--- /dev/null
+++ b/apps/android/app/src/main/java/dev/android/anotheriptvplayer/data/EpisodeUpdateStore.kt
@@ -0,0 +1,139 @@
+package dev.android.anotheriptvplayer.data
+
+import android.content.Context
+import dev.android.anotheriptvplayer.data.local.SeriesWithCategory
+import dev.android.anotheriptvplayer.data.local.WatchHistoryEntity
+import java.time.Instant
+
+/**
+ * A provider-side update detected for a series the user has already watched.
+ *
+ * Xtream does not expose a dedicated "new episode" feed. Most servers do,
+ * however, bump `last_modified` whenever episodes are added. We compare that
+ * value with the last time the profile watched the series. The wording in the
+ * UI deliberately says "update detected" rather than inventing an episode
+ * number that the provider did not send.
+ */
+data class EpisodeUpdate(
+    val seriesId: Int,
+    val seriesName: String,
+    val imageUrl: String?,
+    val categoryName: String,
+    val modifiedAtMillis: Long,
+    val signature: String,
+    val isUnread: Boolean,
+)
+
+/** Pure detector kept separate from persistence so it is straightforward to test. */
+object EpisodeUpdateDetector {
+
+    fun detect(
+        series: List<SeriesWithCategory>,
+        history: List<WatchHistoryEntity>,
+        readSignatures: Set<String>,
+    ): List<EpisodeUpdate> {
+        val latestWatchBySeries = history
+            .asSequence()
+            .filter { it.type == "series" }
+            .mapNotNull { row ->
+                val seriesId = row.seriesId?.toIntOrNull() ?: return@mapNotNull null
+                seriesId to row.lastWatchedAt
+            }
+            .groupingBy { it.first }
+            .fold(0L) { latest, (_, watchedAt) -> maxOf(latest, watchedAt) }
+
+        if (latestWatchBySeries.isEmpty()) return emptyList()
+
+        return series.asSequence()
+            .mapNotNull { row ->
+                val watchedAt = latestWatchBySeries[row.series.seriesId]
+                    ?: return@mapNotNull null
+                val modifiedAt = parseProviderTimestamp(row.series.lastModified)
+                    ?: return@mapNotNull null
+
+                // Provider clocks are occasionally a few seconds ahead. A
+                // one-minute tolerance prevents a false badge immediately
+                // after finishing an episode.
+                if (modifiedAt <= watchedAt + CLOCK_TOLERANCE_MS) return@mapNotNull null
+
+                val signature = "${row.series.seriesId}:$modifiedAt"
+                EpisodeUpdate(
+                    seriesId = row.series.seriesId,
+                    seriesName = row.series.name,
+                    imageUrl = row.series.cover ?: row.series.backdropPath,
+                    categoryName = row.categoryName,
+                    modifiedAtMillis = modifiedAt,
+                    signature = signature,
+                    isUnread = signature !in readSignatures,
+                )
+            }
+            .sortedByDescending(EpisodeUpdate::modifiedAtMillis)
+            .toList()
+    }
+
+    /** Xtream servers return either unix seconds, unix millis, or ISO-8601. */
+    fun parseProviderTimestamp(rawValue: String?): Long? {
+        val value = rawValue?.trim()?.takeIf { it.isNotEmpty() } ?: return null
+        value.toLongOrNull()?.let { numeric ->
+            return if (numeric in 1..99_999_999_999L) numeric * 1_000L else numeric
+        }
+        return runCatching { Instant.parse(value).toEpochMilli() }.getOrNull()
+    }
+
+    private const val CLOCK_TOLERANCE_MS = 60_000L
+}
+
+/** Persists read state without adding a database migration to the first TV preview. */
+class EpisodeUpdateReadStore(context: Context) {
+    private val preferences = context.applicationContext.getSharedPreferences(
+        PREFS_NAME,
+        Context.MODE_PRIVATE,
+    )
+
+    fun readSignatures(playlistId: String): Set<String> =
+        preferences.getStringSet(key(playlistId), emptySet()).orEmpty().toSet()
+
+    fun markRead(playlistId: String, signatures: Collection<String>): Set<String> {
+        if (signatures.isEmpty()) return readSignatures(playlistId)
+        val merged = (readSignatures(playlistId) + signatures)
+            .toList()
+            .takeLast(MAX_SAVED_SIGNATURES)
+            .toSet()
+        preferences.edit().putStringSet(key(playlistId), merged).apply()
+        return merged
+    }
+
+    private fun key(playlistId: String) = "read_updates_$playlistId"
+
+    private companion object {
+        const val PREFS_NAME = "episode_update_state"
+        const val MAX_SAVED_SIGNATURES = 500
+    }
+}
+
+/** Small refresh policy shared by the premium dashboard and its manual refresh action. */
+class CatalogRefreshPolicy(context: Context) {
+    private val preferences = context.applicationContext.getSharedPreferences(
+        PREFS_NAME,
+        Context.MODE_PRIVATE,
+    )
+
+    fun hasBaseline(playlistId: String): Boolean =
+        preferences.contains(key(playlistId))
+
+    fun shouldRefresh(playlistId: String, nowMillis: Long = System.currentTimeMillis()): Boolean {
+        val lastRefresh = preferences.getLong(key(playlistId), 0L)
+        return lastRefresh > 0L && nowMillis - lastRefresh >= REFRESH_INTERVAL_MS
+    }
+
+    fun markRefreshed(playlistId: String, nowMillis: Long = System.currentTimeMillis()) {
+        preferences.edit().putLong(key(playlistId), nowMillis).apply()
+    }
+
+    private fun key(playlistId: String) = "catalog_refresh_$playlistId"
+
+    private companion object {
+        const val PREFS_NAME = "catalog_refresh_policy"
+        const val REFRESH_INTERVAL_MS = 6 * 60 * 60 * 1_000L
+    }
+}
