+private fun selectHero(movies: List<VodStreamWithCategory>): VodStreamWithCategory? {
+    if (movies.isEmpty()) return null
+    return movies
+        .asSequence()
+        .filter { !it.stream.streamIcon.isNullOrBlank() || !it.stream.backdropPath.isNullOrBlank() }
+        .sortedWith(
+            compareByDescending<VodStreamWithCategory> { it.stream.backdropPath != null }
+                .thenByDescending { it.stream.added?.toLongOrNull() ?: 0L }
+                .thenByDescending { it.stream.rating?.toDoubleOrNull() ?: 0.0 },
+        )
+        .firstOrNull()
+        ?: movies.first()
+}
+
+/**
+ * Lightweight, private recommendation model that never uploads viewing data.
+ * It learns the most-watched catalog categories, excludes already-watched
+ * movies, then uses rating and recency as tie-breakers.
+ */
+private fun selectPersonalizedMovies(
+    movies: List<VodStreamWithCategory>,
+    series: List<SeriesWithCategory>,
+    history: List<WatchHistoryEntity>,
+): List<VodStreamWithCategory> {
+    if (history.isEmpty() || movies.isEmpty()) return emptyList()
+
+    val moviesById = movies.associateBy { it.stream.streamId }
+    val seriesById = series.associateBy { it.series.seriesId }
+    val watchedMovieIds = history.asSequence()
+        .filter { it.type == "vod" }
+        .mapNotNull { it.streamId.toIntOrNull() }
+        .toSet()
+    val categoryScores = mutableMapOf<String, Int>()
+
+    history.forEachIndexed { index, row ->
+        val categoryId = when (row.type) {
+            "vod" -> row.streamId.toIntOrNull()?.let(moviesById::get)?.stream?.categoryId
+            "series" -> row.seriesId?.toIntOrNull()?.let(seriesById::get)?.series?.categoryId
+            else -> null
+        }?.takeIf { it.isNotBlank() } ?: return@forEachIndexed
+
+        // Recent activity has a little more influence, while repeated views
+        // naturally reinforce the same category.
+        val recencyWeight = (history.size - index).coerceAtLeast(1)
+        categoryScores[categoryId] = categoryScores.getOrDefault(categoryId, 0) + recencyWeight
+    }
+
+    if (categoryScores.isEmpty()) return emptyList()
+
+    return movies.asSequence()
+        .filter { row ->
+            row.stream.streamId !in watchedMovieIds &&
+                row.stream.categoryId?.let(categoryScores::containsKey) == true
+        }
+        .sortedWith(
+            compareByDescending<VodStreamWithCategory> {
+                it.stream.categoryId?.let(categoryScores::get) ?: 0
+            }
+                .thenByDescending { it.stream.rating?.toDoubleOrNull() ?: 0.0 }
+                .thenByDescending { it.stream.added?.toLongOrNull() ?: 0L },
+        )
+        .take(24)
+        .toList()
+}
