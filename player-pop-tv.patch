index 0000000..1820c18
--- /dev/null
+++ b/apps/android/app/src/test/java/dev/android/anotheriptvplayer/data/EpisodeUpdateDetectorTest.kt
@@ -0,0 +1,97 @@
+package dev.android.anotheriptvplayer.data
+
+import dev.android.anotheriptvplayer.data.local.SeriesEntity
+import dev.android.anotheriptvplayer.data.local.SeriesWithCategory
+import dev.android.anotheriptvplayer.data.local.WatchHistoryEntity
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class EpisodeUpdateDetectorTest {
+
+    @Test
+    fun detectsProviderUpdateAfterLatestWatch() {
+        val watchedAt = 1_700_000_000_000L
+        val modifiedAt = watchedAt + 120_000L
+
+        val result = EpisodeUpdateDetector.detect(
+            series = listOf(series(lastModified = modifiedAt.toString())),
+            history = listOf(history(lastWatchedAt = watchedAt)),
+            readSignatures = emptySet(),
+        )
+
+        assertEquals(1, result.size)
+        assertEquals(42, result.single().seriesId)
+        assertEquals(modifiedAt, result.single().modifiedAtMillis)
+        assertTrue(result.single().isUnread)
+    }
+
+    @Test
+    fun ignoresUpdateWithinProviderClockTolerance() {
+        val watchedAt = 1_700_000_000_000L
+        val result = EpisodeUpdateDetector.detect(
+            series = listOf(series(lastModified = (watchedAt + 30_000L).toString())),
+            history = listOf(history(lastWatchedAt = watchedAt)),
+            readSignatures = emptySet(),
+        )
+
+        assertTrue(result.isEmpty())
+    }
+
+    @Test
+    fun keepsDetectedUpdateButMarksItsSignatureRead() {
+        val watchedAt = 1_700_000_000_000L
+        val modifiedAt = watchedAt + 120_000L
+        val signature = "42:$modifiedAt"
+
+        val result = EpisodeUpdateDetector.detect(
+            series = listOf(series(lastModified = modifiedAt.toString())),
+            history = listOf(history(lastWatchedAt = watchedAt)),
+            readSignatures = setOf(signature),
+        )
+
+        assertEquals(signature, result.single().signature)
+        assertFalse(result.single().isUnread)
+    }
+
+    @Test
+    fun parsesXtreamTimestampVariants() {
+        assertEquals(
+            1_700_000_000_000L,
+            EpisodeUpdateDetector.parseProviderTimestamp("1700000000"),
+        )
+        assertEquals(
+            1_700_000_000_123L,
+            EpisodeUpdateDetector.parseProviderTimestamp("1700000000123"),
+        )
+        assertEquals(
+            1_700_000_000_000L,
+            EpisodeUpdateDetector.parseProviderTimestamp("2023-11-14T22:13:20Z"),
+        )
+        assertNull(EpisodeUpdateDetector.parseProviderTimestamp("unknown"))
+    }
+
+    private fun series(lastModified: String?) = SeriesWithCategory(
+        series = SeriesEntity(
+            seriesId = 42,
+            name = "Example series",
+            cover = "https://images.example/42.jpg",
+            categoryId = "7",
+            playlistId = "playlist",
+            lastModified = lastModified,
+        ),
+        categoryName = "Drama",
+    )
+
+    private fun history(lastWatchedAt: Long) = WatchHistoryEntity(
+        id = "series:42:episode:3",
+        playlistId = "playlist",
+        streamId = "3",
+        type = "series",
+        lastWatchedAt = lastWatchedAt,
+        title = "Example series",
+        seriesId = "42",
+    )
+}
