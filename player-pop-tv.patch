+@Composable
+internal fun TvCatalogScreen(
+    destination: TvDestination,
+    categories: List<CategoryEntity>,
+    liveByCategory: Map<String, List<LiveStreamWithCategory>>,
+    moviesByCategory: Map<String, List<VodStreamWithCategory>>,
+    seriesByCategory: Map<String, List<SeriesWithCategory>>,
+    onOpenLiveCategory: (String) -> Unit,
+    onOpenMovieCategory: (String) -> Unit,
+    onOpenSeriesCategory: (String) -> Unit,
+    onPlayLive: (Int) -> Unit,
+    onOpenMovie: (Int) -> Unit,
+    onOpenSeries: (Int) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    if (categories.isEmpty()) {
+        TvEmptyState(
+            title = stringResource(R.string.tv_empty_catalog_title),
+            body = stringResource(R.string.tv_empty_catalog_body),
+            icon = when (destination) {
+                TvDestination.Live -> Icons.Default.LiveTv
+                TvDestination.Movies -> Icons.Default.Movie
+                else -> Icons.Default.Tv
+            },
+            modifier = modifier.padding(top = 82.dp),
+        )
+        return
+    }
+
+    LazyColumn(
+        modifier = modifier.fillMaxSize(),
+        contentPadding = PaddingValues(top = 104.dp, bottom = 60.dp),
+        verticalArrangement = Arrangement.spacedBy(20.dp),
+    ) {
+        item(key = "catalog-title") {
+            Column(modifier = Modifier.padding(horizontal = 48.dp, vertical = 10.dp)) {
+                Text(
+                    text = stringResource(destination.labelRes),
+                    color = TvTextPrimary,
+                    fontSize = 34.sp,
+                    fontWeight = FontWeight.Bold,
+                )
+                Text(
+                    text = stringResource(R.string.tv_catalog_subtitle),
+                    color = TvTextSecondary,
+                    fontSize = 13.sp,
+                    modifier = Modifier.padding(top = 5.dp),
+                )
+            }
+        }
+
+        items(categories, key = { "${destination.name}:${it.id}" }) { category ->
+            when (destination) {
+                TvDestination.Live -> {
+                    val rows = liveByCategory[category.id].orEmpty().take(24)
+                    if (rows.isNotEmpty()) {
+                        TvShelf(
+                            title = category.name,
+                            onSeeAll = { onOpenLiveCategory(category.id) },
+                        ) {
+                            LazyRow(
+                                contentPadding = PaddingValues(horizontal = 48.dp, vertical = 10.dp),
+                                horizontalArrangement = Arrangement.spacedBy(16.dp),
+                            ) {
+                                items(rows, key = { it.id }) { row ->
+                                    TvLandscapeCard(
+                                        title = row.stream.name,
+                                        imageUrl = row.stream.streamIcon,
+                                        subtitle = category.name,
+                                        icon = Icons.Default.LiveTv,
+                                        onClick = { onPlayLive(row.stream.streamId) },
+                                    )
+                                }
+                            }
+                        }
+                    }
+                }
+
+                TvDestination.Movies -> {
+                    val rows = moviesByCategory[category.id].orEmpty().take(24)
+                    if (rows.isNotEmpty()) {
+                        MovieRail(
+                            title = category.name,
+                            movies = rows,
+                            onOpenMovie = onOpenMovie,
+                            onSeeAll = { onOpenMovieCategory(category.id) },
+                        )
+                    }
+                }
+
+                TvDestination.Series -> {
+                    val rows = seriesByCategory[category.id].orEmpty().take(24)
+                    if (rows.isNotEmpty()) {
+                        SeriesRail(
+                            title = category.name,
+                            series = rows,
+                            onOpenSeries = onOpenSeries,
+                            onSeeAll = { onOpenSeriesCategory(category.id) },
+                        )
+                    }
+                }
+
+                TvDestination.Home -> Unit
+            }
+        }
+    }
+}
