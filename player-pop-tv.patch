+    onDetails: () -> Unit,
+) {
+    Box(
+        modifier = Modifier
+            .fillMaxWidth()
+            .height(470.dp)
+            .background(TvCanvas),
+    ) {
+        val image = movie.stream.backdropPath ?: movie.stream.streamIcon
+        if (!image.isNullOrBlank()) {
+            AsyncImage(
+                model = image,
+                contentDescription = movie.stream.name,
+                contentScale = ContentScale.Crop,
+                modifier = Modifier.fillMaxSize(),
+            )
+        }
+        Box(
+            modifier = Modifier
+                .fillMaxSize()
+                .background(
+                    Brush.horizontalGradient(
+                        0f to TvCanvas,
+                        0.42f to TvCanvas.copy(alpha = 0.82f),
+                        0.72f to TvCanvas.copy(alpha = 0.18f),
+                        1f to TvCanvas.copy(alpha = 0.24f),
+                    ),
+                ),
+        )
+        Box(
+            modifier = Modifier
+                .fillMaxSize()
+                .background(
+                    Brush.verticalGradient(
+                        0f to TvCanvas.copy(alpha = 0.34f),
+                        0.62f to Color.Transparent,
+                        1f to TvCanvas,
+                    ),
+                ),
+        )
+        Column(
+            modifier = Modifier
+                .align(Alignment.CenterStart)
+                .padding(start = 54.dp, top = 62.dp)
+                .fillMaxWidth(0.48f),
+        ) {
+            Text(
+                text = stringResource(R.string.tv_hero_eyebrow),
+                color = TvAccentMint,
+                fontSize = 11.sp,
+                fontWeight = FontWeight.Bold,
+                letterSpacing = 1.5.sp,
+            )
+            Text(
+                text = movie.stream.name,
+                color = TvTextPrimary,
+                fontSize = 42.sp,
+                lineHeight = 46.sp,
+                fontWeight = FontWeight.Bold,
+                maxLines = 2,
+                overflow = TextOverflow.Ellipsis,
+                modifier = Modifier.padding(top = 10.dp),
+            )
+            val metadata = listOfNotNull(
+                movie.stream.releaseDate?.take(4),
+                movie.stream.rating?.takeIf { it.isNotBlank() }?.let { "★ $it" },
+                movie.categoryName.takeIf { it.isNotBlank() },
+            ).joinToString("  •  ")
+            if (metadata.isNotBlank()) {
+                Text(
+                    text = metadata,
+                    color = TvTextSecondary,
+                    fontSize = 13.sp,
+                    fontWeight = FontWeight.Medium,
+                    modifier = Modifier.padding(top = 12.dp),
+                )
+            }
+            movie.stream.plot?.takeIf { it.isNotBlank() }?.let { plot ->
+                Text(
+                    text = plot,
+                    color = TvTextPrimary.copy(alpha = 0.82f),
+                    fontSize = 14.sp,
+                    lineHeight = 20.sp,
+                    maxLines = 3,
+                    overflow = TextOverflow.Ellipsis,
+                    modifier = Modifier.padding(top = 14.dp),
+                )
+            }
+            Row(
+                modifier = Modifier.padding(top = 23.dp),
+                horizontalArrangement = Arrangement.spacedBy(12.dp),
+            ) {
