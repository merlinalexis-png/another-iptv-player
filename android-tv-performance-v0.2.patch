+                        }.getOrNull() ?: continue
+                        chunk += decoded
+                        if (chunk.size >= chunkSize) {
+                            onChunk(chunk.toList())
+                            chunk.clear()
+                        }
+                    }
+                    if (chunk.isNotEmpty()) onChunk(chunk)
+                }
+            }
