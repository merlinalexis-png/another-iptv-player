+                if (!response.isSuccessful) {
+                    throw XtreamException.Server("HTTP ${response.code}")
+                }
+                val body = response.body ?: return@use
+                body.byteStream().use { stream ->
+                    val elements = XtreamJson.decodeToSequence(
+                        stream = stream,
+                        deserializer = JsonElement.serializer(),
+                        format = DecodeSequenceMode.ARRAY_WRAPPED,
+                    )
+                    val chunk = ArrayList<T>(chunkSize)
