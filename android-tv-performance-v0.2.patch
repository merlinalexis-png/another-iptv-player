+            throw e
+        } catch (e: IOException) {
+            throw XtreamException.Network(e)
+        } catch (e: Throwable) {
+            Log.w(TAG, "Streaming decode failed for action=$action (${e.javaClass.simpleName})")
+            throw XtreamException.Decoding(e)
+        }
+    }
