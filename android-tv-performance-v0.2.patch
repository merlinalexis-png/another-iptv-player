+    /**
+     * Memory-bounded TV load. The television UI never needs every catalogue
+     * row in RAM: it gets categories plus small, database-ranked home shelves;
+     * category browsing and search are served by paged SQL queries below.
+     */
+    suspend fun loadPlaylistForTvSuspending(playlist: Playlist) {
+        val token = UUID.randomUUID()
+        loadToken = token
+        _loadError.value = null
+        _loadingMessage.value = null
+
+        if (_activePlaylistId.value != playlist.id) {
+            clearLists()
+            _activePlaylistId.value = playlist.id
+        }
+        _isLoading.value = true
+
+        try {
+            if (needsNetworkBootstrap(playlist.id)) {
+                _loadingMessage.value = appContext.getString(R.string.sync_preparing)
+                syncFromNetworkReplacingLocal(playlist) { message ->
+                    if (loadToken == token) _loadingMessage.value = message
+                }
+                if (loadToken != token) return
+            }
+
+            val categories = fetchCategoriesOnly(playlist.id)
+            if (loadToken != token) return
+            _liveCategories.value = categories.live
+            _vodCategories.value = categories.vod
+            _seriesCategories.value = categories.series
+
+            // These SQL queries return at most a few dozen rows each. Joining
+            // and de-duplicating them is intentionally bounded and cheap.
+            val recent = database.vodStreamDao().recentlyAdded(playlist.id, TV_HOME_RECENT_LIMIT)
+            val rated = database.vodStreamDao().topRated(playlist.id, TV_HOME_RATED_LIMIT)
+            val homeMovies = (recent + rated)
+                .distinctBy { it.stream.streamId }
+                .take(TV_HOME_MOVIE_LIMIT)
+            val homeSeries = database.seriesDao()
+                .recentlyUpdated(playlist.id, TV_HOME_SERIES_LIMIT)
+
+            if (loadToken != token) return
+            _liveStreams.value = emptyList()
+            _vodStreams.value = homeMovies
+            _seriesItems.value = homeSeries
+            _liveStreamsByCategoryId.value = emptyMap()
+            _vodStreamsByCategoryId.value = emptyMap()
+            _seriesItemsByCategoryId.value = emptyMap()
+            _streamsLoaded.value = true
+            _loadingMessage.value = null
+            _isLoading.value = false
+        } catch (e: Throwable) {
+            if (loadToken != token) return
+            Log.e(TAG, "loadPlaylistForTv failed (${e.javaClass.simpleName})")
+            _loadError.value = e.message ?: e.javaClass.simpleName
+            _loadingMessage.value = null
+            _isLoading.value = false
+        }
+    }
+
     /**
      * Convenience for callers that already have a coroutine to await on
      * (e.g. tests, or UI that wants to chain navigation after the sync).
