+import SwiftUI
+import UIKit
+
+/// Native share sheet for a completed local download. It passes a file URL to
+/// AirDrop / Files / other apps instead of loading a potentially multi-GB video in memory.
+struct DownloadShareSheet: UIViewControllerRepresentable {
+    let export: DownloadStorage.PreparedExport
+
+    func makeUIViewController(context: Context) -> UIActivityViewController {
+        let controller = UIActivityViewController(
+            activityItems: [export.url],
+            applicationActivities: nil
+        )
+        controller.completionWithItemsHandler = { _, _, _, _ in
+            DownloadStorage.finishExport(export)
+        }
+        return controller
+    }
+
+    func updateUIViewController(_ uiViewController: UIActivityViewController, context: Context) {}
+}
